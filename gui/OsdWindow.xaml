<Window x:Class="MacropadGUI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macropad OSD" 
        Height="340" Width="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Left="50" Top="50">
    
    <Border Background="#DD1a1a2e" CornerRadius="12" BorderBrush="#e94560" BorderThickness="2"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⌨️ MACROPAD OSD" FontSize="14" FontWeight="Bold" 
                               Foreground="#e94560" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LayerIndicator" Text=" [Layer 1]" FontSize="12" 
                               Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="👁" Width="28" Height="28" Click="ToggleOpacity_Click"
                            Background="Transparent" Foreground="#888" BorderThickness="0"
                            ToolTip="Toggle Opacity" Cursor="Hand"/>
                    <Button Content="✕" Width="28" Height="28" Click="Close_Click"
                            Background="Transparent" Foreground="#e94560" BorderThickness="0"
                            FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Main Layout: Dynamic Buttons Grid + Knobs -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="KnobsColumn" Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Dynamic Button Grid (Left) -->
                <Border Grid.Column="0" Background="#22ffffff" CornerRadius="6" Padding="4" Margin="0,0,8,0">
                    <UniformGrid x:Name="OsdButtonGrid" Rows="4" Columns="4">
                        <!-- Buttons generated dynamically in code -->
                    </UniformGrid>
                </Border>

                <!-- Dynamic Knobs (Right) -->
                <StackPanel Grid.Column="1">
                    <!-- Knob 1 -->
                    <Border x:Name="Knob1Panel" Background="#22ffffff" CornerRadius="6" Padding="6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="◉ Knob 1" FontSize="11" FontWeight="Bold" 
                                       Foreground="#e94560" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <UniformGrid x:Name="Knob1Grid" Rows="1" Columns="3"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Knob 2 -->
                    <Border x:Name="Knob2Panel" Background="#22ffffff" CornerRadius="6" Padding="6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="◉ Knob 2" FontSize="11" FontWeight="Bold" 
                                       Foreground="#e94560" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <UniformGrid x:Name="Knob2Grid" Rows="1" Columns="3"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Knob 3 -->
                    <Border x:Name="Knob3Panel" Background="#22ffffff" CornerRadius="6" Padding="6">
                        <StackPanel>
                            <TextBlock Text="◉ Knob 3" FontSize="11" FontWeight="Bold" 
                                       Foreground="#e94560" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <UniformGrid x:Name="Knob3Grid" Rows="1" Columns="3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer hint -->
            <TextBlock Grid.Row="2" Text="Right-click to edit label • Drag to move • 👁 toggle opacity" 
                       FontSize="10" Foreground="#555" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>
