<Window x:Class="MacropadGUI.EditLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Label" 
        Height="180" Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    
    <Border Background="#EE1a1a2e" CornerRadius="8" BorderBrush="#e94560" BorderThickness="2"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText" Grid.Row="0" Text="Edit Button 1" 
                       FontSize="14" FontWeight="Bold" Foreground="#e94560" Margin="0,0,0,10"/>

            <!-- Current Mapping (readonly) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="Mapping:" FontSize="11" Foreground="#888"/>
                <TextBlock x:Name="MappingText" Text="ctrl-c" FontSize="11" Foreground="#aaa" 
                           TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel>

            <!-- Label Input -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Friendly Name:" FontSize="11" Foreground="#eaeaea"/>
                <TextBox x:Name="LabelInput" FontSize="12" Padding="6,4" Margin="0,4,0,0"
                         Background="#0f3460" Foreground="#eaeaea" BorderBrush="#e94560"
                         CaretBrush="#e94560"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="70" Padding="8,4" Margin="0,0,8,0"
                        Background="#333" Foreground="#888" BorderThickness="0"
                        Click="Cancel_Click" Cursor="Hand"/>
                <Button Content="Save" Width="70" Padding="8,4"
                        Background="#e94560" Foreground="White" BorderThickness="0"
                        Click="Save_Click" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
