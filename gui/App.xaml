<Application x:Class="MacropadGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- COLOR PALETTE - Modern Dark Theme                                -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        
        <Color x:Key="BgDeep">#0D0D12</Color>
        <Color x:Key="BgBase">#13131A</Color>
        <Color x:Key="BgSurface">#1A1A24</Color>
        <Color x:Key="BgCard">#22222E</Color>
        <Color x:Key="BgCardHover">#2A2A38</Color>
        
        <Color x:Key="AccentPrimary">#E94560</Color>
        <Color x:Key="AccentSecondary">#0F3460</Color>
        <Color x:Key="AccentSuccess">#10B981</Color>
        <Color x:Key="AccentWarning">#F59E0B</Color>
        
        <Color x:Key="TextPrimary">#F8F8F8</Color>
        <Color x:Key="TextSecondary">#A0A0B0</Color>
        <Color x:Key="TextMuted">#606070</Color>
        
        <!-- Brushes -->
        <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeep}"/>
        <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}"/>
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
        <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHover}"/>
        
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPrimary}"/>
        <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondary}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource AccentSuccess}"/>
        
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
        
        <!-- Legacy compatibility -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BgDeep}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource BgSurface}"/>
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource AccentPrimary}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextMuted}"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- KEY BUTTON CARD STYLE - Main Grid Buttons                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" 
                                                  Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" 
                                        Value="{StaticResource BgCardHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" 
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" 
                                        Value="{StaticResource AccentSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- KNOB BUTTON STYLE - Compact for rotary controls                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        
        <Style x:Key="KnobButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" 
                                        Value="{StaticResource BgCardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" 
                                        Value="{StaticResource AccentSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACTION BUTTON STYLE - Top toolbar buttons                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        
        <Style x:Key="MacroButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" 
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- COMBOBOX STYLE - Layer selector                                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TEXTBOX STYLE - Input fields                                     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

    </Application.Resources>
</Application>
